        </tr>
      `;

      document.getElementById('drillthrough-drawer').classList.remove('hidden');
    }

    function closeDrillthrough() {
      document.getElementById('drillthrough-drawer').classList.add('hidden');
    }

    // Modal Triggers
    function toggleCaseStudyModal() {
      const m = document.getElementById('casestudy-modal');
      m.open ? m.close() : m.showModal();
    }

    function openGitHubModal() {
      const modal = document.getElementById('github-modal');
      document.getElementById('code-box').value = document.documentElement.outerHTML;
      modal.showModal();
