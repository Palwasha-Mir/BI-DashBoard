<body class="min-h-screen flex flex-col antialiased select-none">

  <!-- 1. CORPORATE TOP HEADER -->
  <header class="bg-[#1B365D] text-white border-b border-slate-700 shadow-sm sticky top-0 z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-3">
      
      <!-- Title & Branding -->
      <div class="flex items-center space-x-3.5">
        <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-teal-400 to-emerald-500 flex items-center justify-center text-white shadow-md">
          <i class="fa-solid fa-chart-line text-lg"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white font-sans">
              Financial Operations &amp; B2B Revenue Performance Dashboard
            </h1>
            <span class="px-2 py-0.5 text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 rounded-full hidden sm:inline-flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Production Audit Mode
            </span>
          </div>
          <div class="flex items-center space-x-2 text-xs text-slate-300 mt-0.5">
            <span class="font-medium text-teal-300">Earscure / Mir's Core B2B Wholesale Operations</span>
            <span>•</span>
            <span class="text-slate-300">Last Updated: Nov 19, 2026</span>
          </div>
        </div>
      </div>

      <!-- Header Portfolio Badges & Action Buttons -->
      <div class="flex items-center space-x-2.5">
        <!-- Dataset Disclaimer Badge -->
        <div class="hidden lg:flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-800/80 border border-slate-700 text-[11px] text-slate-300">
          <i class="fa-solid fa-database text-teal-400"></i>
          <span>Sample / Portfolio Dataset • Cleaned via SQL &amp; Excel</span>
        </div>

        <!-- Portfolio Case Study Button -->
        <button onclick="toggleCaseStudyModal()" class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 font-semibold text-xs transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-solid fa-file-contract text-teal-400"></i>
          <span>Case Study (Problem → Result)</span>
        </button>

        <!-- Copy GitHub Code Modal -->
        <button onclick="openGitHubModal()" class="px-3.5 py-1.5 rounded-lg bg-teal-600 hover:bg-teal-500 text-white font-semibold text-xs transition flex items-center gap-1.5 shadow-sm">
          <i class="fa-brands fa-github text-sm"></i>
          <span>GitHub Code</span>
        </button>
      </div>

    </div>
  </header>

  <!-- 2. TOP SLICER BAR & BOOKMARK VIEW PRESETS -->
  <section class="bg-white border-b border-slate-200 px-4 sm:px-6 py-3 shadow-xs">
    <div class="max-w-7xl mx-auto flex flex-col space-y-3">
      
      <!-- Top Row: Bookmark Views & Slicer Header -->
      <div class="flex flex-wrap justify-between items-center gap-2">
        <!-- Bookmark Views -->
        <div class="flex items-center space-x-2">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1">
            <i class="fa-solid fa-bookmark text-brand-navy"></i> Views:
          </span>
          <button onclick="applyBookmark('exec')" id="bm-exec" class="bookmark-btn active px-3 py-1 rounded-md text-xs font-semibold border border-slate-300 bg-slate-50 text-slate-700 hover:bg-slate-100 transition">
            Executive Summary
          </button>
          <button onclick="applyBookmark('variance')" id="bm-variance" class="bookmark-btn px-3 py-1 rounded-md text-xs font-semibold border border-slate-300 bg-slate-50 text-slate-700 hover:bg-slate-100 transition">
            Variance &amp; Audit Focus
          </button>
          <button onclick="applyBookmark('fulfillment')" id="bm-fulfillment" class="bookmark-btn px-3 py-1 rounded-md text-xs font-semibold border border-slate-300 bg-slate-50 text-slate-700 hover:bg-slate-100 transition">
            Client Fulfillment
          </button>
        </div>

        <!-- Filter Count Badge & Reset -->
        <div class="flex items-center space-x-3 text-xs">
          <span class="text-slate-500 font-medium" id="slicer-summary-text">Showing: All Periods • All Export Markets • All Product Categories</span>
          <button onclick="resetSlicers()" class="text-brand-navy hover:text-teal-600 font-semibold flex items-center gap-1 transition">
            <i class="fa-solid fa-rotate-right text-[10px]"></i> Reset Slicers
          </button>
        </div>
      </div>

      <!-- Slicer Select Controls Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
        
        <!-- Slicer 1: Date Range -->
        <div class="flex flex-col space-y-1">
          <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider flex items-center justify-between">
            <span>Date Range Slicer</span>
            <i class="fa-regular fa-calendar text-slate-400"></i>
          </label>
          <select id="slicer-date" onchange="onSlicerChange()" class="bg-slate-50 border border-slate-300 focus:border-brand-navy focus:bg-white text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none font-medium cursor-pointer transition">
            <option value="all">FY 2026 Full Year</option>
            <option value="Q1">Q1 2026 (Jan – Mar)</option>
            <option value="Q2">Q2 2026 (Apr – Jun)</option>
            <option value="Q3">Q3 2026 (Jul – Sep)</option>
            <option value="Q4">Q4 2026 (Oct – Dec Forecast)</option>
          </select>
        </div>

        <!-- Slicer 2: Region / Export Market -->
        <div class="flex flex-col space-y-1">
          <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider flex items-center justify-between">
            <span>Export Market Slicer</span>
            <i class="fa-solid fa-earth-americas text-slate-400"></i>
          </label>
          <select id="slicer-region" onchange="onSlicerChange()" class="bg-slate-50 border border-slate-300 focus:border-brand-navy focus:bg-white text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none font-medium cursor-pointer transition">
            <option value="all">All Export Markets</option>
            <option value="UAE &amp; GCC">UAE &amp; GCC (Dubai, KSA, Qatar, Kuwait)</option>
            <option value="UK &amp; Europe">UK &amp; Europe B2B Boutiques</option>
            <option value="North America">North America (USA &amp; Canada)</option>
            <option value="Pakistan Domestic">Pakistan Domestic Wholesale</option>
          </select>
        </div>

        <!-- Slicer 3: Product Category -->
        <div class="flex flex-col space-y-1">
          <label class="text-[11px] font-bold text-slate-600 uppercase tracking-wider flex items-center justify-between">
            <span>Product Category Slicer</span>
            <i class="fa-solid fa-boxes-stacked text-slate-400"></i>
          </label>
          <select id="slicer-category" onchange="onSlicerChange()" class="bg-slate-50 border border-slate-300 focus:border-brand-navy focus:bg-white text-slate-800 text-xs rounded-lg px-3 py-2 focus:outline-none font-medium cursor-pointer transition">
            <option value="all">All Product Lines</option>
            <option value="Luxury Abayas">Luxury Abayas</option>
            <option value="Royal Kaftans">Royal Kaftans</option>
            <option value="Evening Robes">Evening Robes &amp; Capes</option>
            <option value="Gold-Zari Couture">Gold-Zari Couture Edition</option>
          </select>
        </div>

      </div>

    </div>
  </section>

  <!-- 3. MAIN DASHBOARD CONTENT CANVAS -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 space-y-6">

    <!-- TOP KPI CARDS ROW (4 MUST-HAVE NUMERIC CARDS) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- KPI CARD 1: Total Processed Revenue -->
      <div class="dashboard-card p-4 flex flex-col justify-between relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Processed Revenue</span>
          <span id="kpi-rev-badge" class="px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full flex items-center gap-1"><i class="fa-solid fa-arrow-trend-up"></i> +9.3%</span>
        </div>
        <div class="my-3">
          <div id="kpi-rev-val" class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight">$493,900</div>
          <div id="kpi-rev-sub" class="text-xs text-slate-500 mt-1">Target Budget: $452,000</div>
        </div>
        <div class="h-8 w-full pt-1">
          <svg class="w-full h-full stroke-teal-600 fill-teal-500/10" viewBox="0 0 100 25">
            <path d="M0 22 Q 25 15, 50 18 T 75 8 T 100 3 L 100 25 L 0 25 Z" stroke-width="0"></path>
            <path d="M0 22 Q 25 15, 50 18 T 75 8 T 100 3" stroke-width="2" fill="none"></path>
          </svg>
        </div>
      </div>

      <!-- KPI CARD 2: Budget vs. Actual Variance % -->
      <div class="dashboard-card p-4 flex flex-col justify-between relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Budget Variance %</span>
          <span id="kpi-var-status" class="px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full">Favorable</span>
        </div>
        <div class="my-3">
          <div id="kpi-var-val" class="text-2xl sm:text-3xl font-extrabold text-emerald-600 tracking-tight">+9.27%</div>
          <div id="kpi-var-sub" class="text-xs text-slate-500 mt-1">+$41,900 Above Forecast</div>
        </div>
        <div class="h-8 w-full pt-1 flex items-end">
          <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden border border-slate-200">
            <div id="kpi-var-bar" class="bg-emerald-500 h-full rounded-full" style="width: 77.8097%;"></div>
          </div>
        </div>
      </div>

      <!-- KPI CARD 3: Reconciliation Accuracy % -->
      <div class="dashboard-card p-4 flex flex-col justify-between relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Reconciliation Accuracy</span>
          <span class="px-2 py-0.5 text-[11px] font-semibold bg-teal-50 text-teal-700 border border-teal-200 rounded-full">
            SQL Automated
          </span>
        </div>
        <div class="my-3">
          <div id="kpi-acc-val" class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight">99.58%</div>
          <div id="kpi-acc-sub" class="text-xs text-slate-500 mt-1">Error Rate: 0.36% (1 Audit Flag)</div>
        </div>
        <div class="h-8 w-full pt-1 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100">
          <span>Match Rule: Star Schema</span>
          <span class="text-teal-700 font-semibold"><i class="fa-solid fa-check-double text-teal-600"></i> Verified</span>
        </div>
      </div>

      <!-- KPI CARD 4: Avg Turnaround Time & Automation Savings -->
      <div class="dashboard-card p-4 flex flex-col justify-between relative overflow-hidden">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Avg Turnaround Time</span>
          <span class="px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full">
            -38% Cycle
          </span>
        </div>
        <div class="my-3">
          <div id="kpi-tat-val" class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight">4.0 Days</div>
          <div id="kpi-tat-sub" class="text-xs text-slate-500 mt-1">Reduced from 6.8 Days Baseline</div>
        </div>
        <div class="h-8 w-full pt-1 flex items-center justify-between text-xs text-slate-500 border-t border-slate-100">
          <span>Automation Savings:</span>
          <span class="font-bold text-emerald-700">~14.5 Hours/Wk</span>
        </div>
      </div>

    </div>

    <!-- 4 CORE VISUAL CHARTS (2x2 GRID) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

      <!-- VISUAL 1: Monthly Processed Revenue & Volume Trend (Line/Area) -->
      <div class="dashboard-card p-5 flex flex-col min-h-[340px]">
        <div class="flex flex-wrap justify-between items-center mb-4 gap-2">
          <div>
            <h3 class="text-sm font-bold text-brand-navy flex items-center gap-2">
