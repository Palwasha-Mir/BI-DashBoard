    // Update KPI Numeric Cards
    function updateKPIs(data) {
      const totalTarget = data.reduce((sum, item) => sum + item.target, 0);
      const totalActual = data.reduce((sum, item) => sum + item.actual, 0);
      const variancePct = totalTarget > 0 ? ((totalActual - totalTarget) / totalTarget) * 100 : 0;
      
      const avgAcc = data.length > 0 ? (data.reduce((sum, item) => sum + item.acc, 0) / data.length).toFixed(2) : "100.00";
      const avgTat = data.length > 0 ? (data.reduce((sum, item) => sum + item.tat, 0) / data.length).toFixed(1) : "0.0";

      // KPI 1: Revenue
      document.getElementById('kpi-rev-val').textContent = `$${totalActual.toLocaleString()}`;
      document.getElementById('kpi-rev-sub').textContent = `Target Budget: $${totalTarget.toLocaleString()}`;
      
      const badgeElem = document.getElementById('kpi-rev-badge');
      if (variancePct >= 0) {
        badgeElem.className = "px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full flex items-center gap-1";
        badgeElem.innerHTML = `<i class="fa-solid fa-arrow-trend-up"></i> +${variancePct.toFixed(1)}%`;
      } else {
        badgeElem.className = "px-2 py-0.5 text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 rounded-full flex items-center gap-1";
        badgeElem.innerHTML = `<i class="fa-solid fa-arrow-trend-down"></i> ${variancePct.toFixed(1)}%`;
      }

      // KPI 2: Variance
      const varValElem = document.getElementById('kpi-var-val');
      const varStatusElem = document.getElementById('kpi-var-status');
      const varBarElem = document.getElementById('kpi-var-bar');
      const diffVal = totalActual - totalTarget;

      if (variancePct >= 0) {
        varValElem.textContent = `+${variancePct.toFixed(2)}%`;
        varValElem.className = "text-2xl sm:text-3xl font-extrabold text-emerald-600 tracking-tight";
        varStatusElem.textContent = "Favorable";
        varStatusElem.className = "px-2 py-0.5 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full";
        document.getElementById('kpi-var-sub').textContent = `+$${Math.abs(diffVal).toLocaleString()} Above Forecast`;
        varBarElem.className = "bg-emerald-500 h-full rounded-full";
        varBarElem.style.width = `${Math.min(100, 50 + variancePct * 3)}%`;
      } else {
        varValElem.textContent = `${variancePct.toFixed(2)}%`;
        varValElem.className = "text-2xl sm:text-3xl font-extrabold text-brand-coral tracking-tight";
        varStatusElem.textContent = "Unfavorable";
        varStatusElem.className = "px-2 py-0.5 text-[11px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 rounded-full";
        document.getElementById('kpi-var-sub').textContent = `-$${Math.abs(diffVal).toLocaleString()} Below Target`;
        varBarElem.className = "bg-brand-coral h-full rounded-full";
        varBarElem.style.width = `${Math.max(10, 50 + variancePct * 3)}%`;
      }

