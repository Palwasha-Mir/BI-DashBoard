    // Dynamic Chart Updates based on Filtered Data
    function updateCharts(filteredData) {
      if (!chartMarkets) return;

      // Aggregates for Markets
      const regMap = { 'UAE & GCC': 0, 'UK & Europe': 0, 'North America': 0, 'Pakistan Domestic': 0 };
      const catActualMap = { 'Royal Kaftans': 0, 'Gold-Zari Couture': 0, 'Luxury Abayas': 0, 'Evening Robes': 0 };
      const catTargetMap = { 'Royal Kaftans': 0, 'Gold-Zari Couture': 0, 'Luxury Abayas': 0, 'Evening Robes': 0 };
      const statusMap = { 'Automated Matched': 0, 'Custom Verified': 0, 'Pending Review': 0 };

      filteredData.forEach(d => {
        if (regMap[d.region] !== undefined) regMap[d.region] += d.actual;
        if (catActualMap[d.category] !== undefined) {
          catActualMap[d.category] += d.actual;
          catTargetMap[d.category] += d.target;
        }
        if (statusMap[d.status] !== undefined) statusMap[d.status]++;
      });

      // Visual 2 Update
      chartMarkets.data.datasets[0].data = [
        regMap['UAE & GCC'], regMap['UK & Europe'], regMap['North America'], regMap['Pakistan Domestic']
      ];
      chartMarkets.update();

      // Visual 3 Update
      chartVariance.data.datasets[0].data = [
        catActualMap['Royal Kaftans'], catActualMap['Gold-Zari Couture'], catActualMap['Luxury Abayas'], catActualMap['Evening Robes']
      ];
      chartVariance.data.datasets[1].data = [
        catTargetMap['Royal Kaftans'], catTargetMap['Gold-Zari Couture'], catTargetMap['Luxury Abayas'], catTargetMap['Evening Robes']
      ];
      chartVariance.update();

      // Visual 4 Update
      chartStatus.data.datasets[0].data = [
        statusMap['Automated Matched'], statusMap['Custom Verified'], statusMap['Pending Review']
      ];
      chartStatus.update();
    }

    // Render Matrix Detail Table
    function renderTable(dataToRender) {
      const data = dataToRender || getFilteredData();
      const tbody = document.getElementById('matrix-tbody');
      const query = document.getElementById('table-search').value.toLowerCase();

      let items = data.filter(i => 
        i.client.toLowerCase().includes(query) ||
        i.region.toLowerCase().includes(query) ||
        i.category.toLowerCase().includes(query) ||
        i.status.toLowerCase().includes(query)
      );

      // Sort Items
      items.sort((a, b) => {
        let valA = a[currentSortCol];
        let valB = b[currentSortCol];
        if (currentSortCol === 'variance') {
          valA = ((a.actual - a.target) / a.target);
          valB = ((b.actual - b.target) / b.target);
        }
        if (typeof valA === 'string') {
          return currentSortAsc ? valA.localeCompare(valB) : valB.localeCompare(valA);
        }
        return currentSortAsc ? valA - valB : valB - valA;
      });

      tbody.innerHTML = '';
      if (items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-6 text-slate-400">No client records found matching search or slicer rules.</td></tr>`;
        return;
      }

      let aggregatedActual = 0;

      items.forEach((row, idx) => {
        aggregatedActual += row.actual;
        const diffPct = ((row.actual - row.target) / row.target) * 100;
        const isFavorable = diffPct >= 0;
        
        const varBadgeClass = isFavorable 
          ? 'text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200' 
          : 'text-rose-700 font-bold bg-rose-50 px-2 py-0.5 rounded border border-rose-200';

        let statusPillClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
        if (row.status === 'Custom Verified') statusPillClass = 'bg-teal-50 text-teal-700 border-teal-200';
        if (row.status === 'Pending Review') statusPillClass = 'bg-amber-50 text-amber-700 border-amber-200';

        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-50/80 transition cursor-pointer";
        tr.onclick = () => openDrillthrough(row);

        tr.innerHTML = `
          <td class="py-3 px-4 font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-store text-teal-600 text-xs"></i>
            <span>${row.client}</span>
          </td>
          <td class="py-3 px-4 text-slate-600">${row.category}</td>
          <td class="py-3 px-4 text-slate-600">${row.region}</td>
          <td class="py-3 px-4 text-right font-mono text-slate-500">$${row.target.toLocaleString()}</td>
          <td class="py-3 px-4 text-right font-mono font-bold text-brand-navy">$${row.actual.toLocaleString()}</td>
          <td class="py-3 px-4 text-right">
            <span class="${varBadgeClass}">${isFavorable ? '+' : ''}${diffPct.toFixed(1)}%</span>
          </td>
          <td class="py-3 px-4 text-center font-mono font-semibold text-slate-700">${row.acc}%</td>
          <td class="py-3 px-4 text-center">
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold border ${statusPillClass}">${row.status}</span>
          </td>
          <td class="py-3 px-4 text-center">
            <button onclick="event.stopPropagation(); openDrillthrough('${row.id}')" class="px-2.5 py-1 text-[11px] font-semibold text-brand-navy hover:text-teal-600 bg-slate-100 hover:bg-slate-200 rounded border border-slate-300 transition">
              <i class="fa-solid fa-magnifying-glass-chart"></i> Audit
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });

      document.getElementById('tbl-count').textContent = items.length;
      document.getElementById('tbl-total-actual').textContent = `$${aggregatedActual.toLocaleString()}`;
    }

    function sortTable(col) {
      if (currentSortCol === col) {
        currentSortAsc = !currentSortAsc;
      } else {
        currentSortCol = col;
        currentSortAsc = false;
      }
      renderTable();
    }

    // Bookmark Presets Logic
    function applyBookmark(type) {
      resetBookmarkButtons();
      resetSlicers();

      if (type === 'exec') {
        document.getElementById('bm-exec').classList.add('active');
      } else if (type === 'variance') {
        document.getElementById('bm-variance').classList.add('active');
        document.getElementById('slicer-category').value = 'Gold-Zari Couture';
      } else if (type === 'fulfillment') {
        document.getElementById('bm-fulfillment').classList.add('active');
        document.getElementById('slicer-region').value = 'UAE & GCC';
      }
      onSlicerChange();
    }

    function resetBookmarkButtons() {
      document.querySelectorAll('.bookmark-btn').forEach(b => b.classList.remove('active'));
    }

    // Drill-Through Slide-Over Drawer
    function openDrillthrough(itemOrId) {
      let item = itemOrId;
      if (typeof itemOrId === 'string') {
        item = masterClients.find(c => c.id === itemOrId);
      }
      if (!item) return;

      document.getElementById('drawer-client-name').textContent = item.client;
      document.getElementById('drawer-client-meta').textContent = `${item.category} • ${item.region} • ${item.quarter}`;
      document.getElementById('drawer-target-val').textContent = `$${item.target.toLocaleString()}`;
      document.getElementById('drawer-actual-val').textContent = `$${item.actual.toLocaleString()}`;

      // Populate Mock Invoices
      const invBody = document.getElementById('drawer-invoices-tbody');
      invBody.innerHTML = `
        <tr class="hover:bg-slate-50">
          <td class="py-2 px-3 font-mono font-bold text-brand-navy">INV-2026-081</td>
          <td class="py-2 px-3 text-slate-500">2026-02-14</td>
